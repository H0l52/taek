{
  "name": "taek",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Kukkiwon taekwondo tutorials: an installable iPhone web app.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "build": "astro build",
    "preview": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "design:detect": "impeccable detect src/",
    "design:detect:dist": "impeccable detect dist/"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.7",
    "impeccable": "4.11.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
