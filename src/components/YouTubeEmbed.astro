---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  start?: number | undefined;
  poster?: ImageMetadata | undefined;
}
const { id, title, start, poster } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}${start ? `&t=${start}s` : ''}`;
---
<figure class="yt" data-youtube={id} data-start={start ?? ''} data-title={title}>
  <div class="frame">
    <button type="button" class="facade">
      {poster && <Image src={poster} alt="" widths={[640, 1280]} sizes="(min-width: 40rem) 38rem, 100vw" class="poster" />}
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
      </span>
      <span class="visually-hidden">Play video: {title}</span>
    </button>
    <p class="offline" role="status" hidden>You're offline. The video will play when you're back online.</p>
  </div>
  <figcaption>
    <span>YouTube · loads when you tap play</span>
    <a href={watch} rel="noopener" target="_blank">Open in YouTube</a>
  </figcaption>
</figure>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>('[data-youtube]')) {
    const button = figure.querySelector<HTMLButtonElement>('.facade');
    const offline = figure.querySelector<HTMLElement>('.offline');
    button?.addEventListener('click', () => {
      if (!navigator.onLine) {
        if (offline) offline.hidden = false;
        return;
      }
      const params = new URLSearchParams({ playsinline: '1', autoplay: '1', rel: '0' });
      if (figure.dataset.start) params.set('start', figure.dataset.start);
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${figure.dataset.youtube}?${params}`;
      iframe.title = figure.dataset.title ?? 'YouTube video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      button.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>

<style>
  .yt {
    margin: 0 calc(-1 * var(--space-4)) var(--space-5);
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #121212;
  }
  .facade,
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .facade {
    display: grid;
    place-items: center;
    padding: 0;
    background: #121212;
    cursor: pointer;
  }
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: relative;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: #121212;
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.35);
    transition: transform var(--dur) var(--ease-out);
  }
  .play svg {
    width: 1.75rem;
    height: 1.75rem;
    margin-left: 0.1875rem;
  }
  .facade:active .play {
    transform: scale(0.94);
  }
  .offline {
    position: absolute;
    inset: auto var(--space-4) var(--space-4);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: #fffdf9;
    color: #18181a;
    font-size: var(--text-sm);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  figcaption a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--seal);
  }
  @media (min-width: 40rem) {
    .yt {
      margin-inline: 0;
    }
    .frame {
      border-radius: var(--radius);
      overflow: hidden;
    }
  }
</style>
