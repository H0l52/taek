---
import { SECTIONS } from '../lib/sections';
import { url } from '../lib/paths';
interface Props { current?: string | undefined; exact?: boolean; }
const { current, exact = false } = Astro.props;
---
<nav class="tabbar" aria-label="Sections">
  <ul>
    {SECTIONS.map((s) => (
      <li>
        <a
          href={url(`${s.slug}/`)}
          class:list={{ active: s.slug === current }}
          aria-current={s.slug === current ? (exact ? 'page' : 'true') : undefined}
        >
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{s.short}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    background: var(--surface);
    border-top: 1px solid var(--rule);
    padding: 0 var(--safe-right) var(--safe-bottom) var(--safe-left);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    max-width: 40rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.3125rem;
    min-height: var(--tabbar-h);
    padding: var(--space-1) var(--space-1);
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .dot {
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: transparent;
    transition: background-color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
    transform: scale(0.4);
  }
  .active {
    color: var(--ink);
  }
  .active .dot {
    background: var(--seal);
    transform: scale(1);
  }
  .label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
